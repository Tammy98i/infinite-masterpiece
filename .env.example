# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Stripe: leave empty to keep lead-only capture. When STRIPE_SECRET_KEY is set,
# Brave and Hesitant forms redirect to Stripe Checkout (ILS + 17% VAT).
# Local webhooks: stripe listen --forward-to localhost:3001/api/checkout/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Object storage: leave empty to keep files on the local disk (server/data/uploads).
# When S3_BUCKET + keys are set, uploads go to S3 or an S3-compatible store (R2, MinIO).
# R2 example: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Webinar funnel — email (Resend) + CRM webhook
# Never commit the real key. EMAIL_FROM must be an address on a verified Resend domain.
RESEND_API_KEY=""
EMAIL_FROM="Infinite Masterpiece <noreply@infinite-masterpiece.co.il>"
WEBINAR_WEBHOOK_URL=""
VITE_GA4_ID=""
VITE_META_PIXEL_ID=""

# Optional separate API origin (leave empty locally — Vite proxies /api).
VITE_API_URL=""

# Supabase Auth (optional). When set, login/register/Google go through Supabase.
# Get URL + anon key from Supabase → Settings → API. See docs/SUPABASE-AUTH.md
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Comma-separated emails that become admin on the Vercel/Supabase path.
VITE_ADMIN_EMAILS="tam98iiy@gmail.com"

# Accessibility statement — coordinator contact shown on /accessibility (server + client)
# Replace coordinator name/phone with real details before production (see docs/A11Y-OPERATIONS.md)
A11Y_COORDINATOR_NAME="רכז/ת נגישות — Infinite Masterpiece"
A11Y_CONTACT_EMAIL="negishot@infinite-masterpiece.co.il"
A11Y_CONTACT_PHONE=""
A11Y_CONTACT_PHONE_DISPLAY=""
A11Y_LAST_AUDIT_DATE="22 באוגוסט 2026"
A11Y_STATEMENT_UPDATED="22 באוגוסט 2026"
A11Y_RESPONSE_DAYS="14"
VITE_A11Y_COORDINATOR_NAME="רכז/ת נגישות — Infinite Masterpiece"
VITE_A11Y_CONTACT_EMAIL="negishot@infinite-masterpiece.co.il"
VITE_A11Y_CONTACT_PHONE=""
VITE_A11Y_CONTACT_PHONE_DISPLAY=""
VITE_A11Y_LAST_AUDIT_DATE="22 באוגוסט 2026"
VITE_A11Y_STATEMENT_UPDATED="22 באוגוסט 2026"

