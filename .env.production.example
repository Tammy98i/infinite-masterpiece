# Production environment — copy to `.env` on the server (never commit secrets).

NODE_ENV=production
PORT=3000
APP_URL="https://your-domain.co.il"
PUBLIC_UPLOAD_ORIGIN="https://your-domain.co.il"

# Stripe (live keys in production dashboard)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Object storage (recommended for video at scale)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Accessibility / legal (must match VITE_* for client bundle at build time)
A11Y_COORDINATOR_NAME=""
A11Y_CONTACT_EMAIL=""
A11Y_CONTACT_PHONE=""
A11Y_CONTACT_PHONE_DISPLAY=""
A11Y_LAST_AUDIT_DATE=""
A11Y_STATEMENT_UPDATED=""
A11Y_RESPONSE_DAYS="14"
VITE_A11Y_COORDINATOR_NAME=""
VITE_A11Y_CONTACT_EMAIL=""
VITE_A11Y_CONTACT_PHONE=""
VITE_A11Y_CONTACT_PHONE_DISPLAY=""
VITE_A11Y_LAST_AUDIT_DATE=""
VITE_A11Y_STATEMENT_UPDATED=""

# Webinar funnel — email + CRM + marketing pixels (build-time VITE_*)
RESEND_API_KEY=""
EMAIL_FROM="Infinite Masterpiece <noreply@infinite-masterpiece.co.il>"
WEBINAR_WEBHOOK_URL=""
VITE_GA4_ID=""
VITE_META_PIXEL_ID=""

# Optional separate API origin. Leave empty when using Vercel /api functions.
VITE_API_URL=""

# Supabase Auth (optional). Same values as VITE_* for the Node API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VITE_ADMIN_EMAILS="tam98iiy@gmail.com"

# Optional
GEMINI_API_KEY=""
